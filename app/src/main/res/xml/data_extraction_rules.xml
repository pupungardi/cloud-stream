<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Kecualikan database Room riwayat tonton dan sumber kustom dari cloud backup -->
        <exclude domain="database" path="cloudstream_database" />
        <exclude domain="database" path="cloudstream_database-shm" />
        <exclude domain="database" path="cloudstream_database-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="cloudstream_database" />
        <exclude domain="database" path="cloudstream_database-shm" />
        <exclude domain="database" path="cloudstream_database-wal" />
    </device-transfer>
</data-extraction-rules>
